<?xml version="1.0" encoding="utf-8"?>
<!-- AI tools. Quick Remove runs the engine's own Select Subject + edge refinement (offline, no
     download). High quality runs an ONNX model on-device; the panel shows the model's real state,
     download progress and a cancel button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pc_surface_panel"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_3">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ai_title"
        android:textAppearance="@style/Widget.PhotoCraft.PanelTitle" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/quickCard"
        style="@style/Widget.PhotoCraft.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_3">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_quick_remove"
                android:textAppearance="@style/TextAppearance.PhotoCraft.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/ai_quick_remove_body"
                android:textAppearance="@style/TextAppearance.PhotoCraft.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quickRun"
                style="@style/Widget.PhotoCraft.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:text="@string/ai_quick_remove"
                app:icon="@drawable/ic_magic" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.PhotoCraft.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_3">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_high_quality"
                android:textAppearance="@style/TextAppearance.PhotoCraft.Title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/ai_high_quality_body"
                android:textAppearance="@style/TextAppearance.PhotoCraft.Body" />

            <Spinner
                android:id="@+id/modelSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2" />

            <TextView
                android:id="@+id/modelState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/ai_model_state_missing"
                android:textAppearance="@style/TextAppearance.PhotoCraft.Caption"
                tools:text="Model ready" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/downloadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:visibility="gone"
                app:indicatorColor="@color/pc_primary"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_2"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downloadModel"
                    style="@style/Widget.PhotoCraft.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/space_1"
                    android:layout_weight="1"
                    android:text="@string/ai_download_model" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hqRun"
                    style="@style/Widget.PhotoCraft.Button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ai_high_quality" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelButton"
                style="@style/Widget.PhotoCraft.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_1"
                android:text="@string/ai_cancel"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectSubject"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1"
            android:layout_weight="1"
            android:text="@string/ai_select_subject" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectSky"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ai_select_sky" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:textAppearance="@style/TextAppearance.PhotoCraft.Caption"
        tools:text="Inference 412 ms · total 780 ms" />
</LinearLayout>
