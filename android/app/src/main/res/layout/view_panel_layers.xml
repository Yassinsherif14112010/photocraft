<?xml version="1.0" encoding="utf-8"?>
<!-- Layers panel: the real layer tree from the engine, plus the row actions that map to engine
     commands (visibility, opacity, reorder, duplicate, rename, delete, group, mask). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pc_surface_panel"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_3">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/layers_title"
            android:textAppearance="@style/Widget.PhotoCraft.PanelTitle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addLayer"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/layers_add"
            app:icon="@drawable/ic_add" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/space_2"
        android:background="@color/pc_divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/layerList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="160dp"
        tools:listitem="@layout/item_layer" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_4"
        android:text="@string/layers_empty"
        android:textAlignment="center"
        android:textAppearance="@style/TextAppearance.PhotoCraft.Body"
        android:visibility="gone" />

    <!-- Selection-scoped controls -->
    <TextView
        android:id="@+id/opacityLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/layers_opacity"
        android:textAppearance="@style/TextAppearance.PhotoCraft.Caption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/opacity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1.0"
        android:value="100.0"
        android:valueFrom="0.0"
        android:valueTo="100.0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/up"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1"
            android:contentDescription="@string/layers_up"
            app:icon="@drawable/ic_arrow_up" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/down"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1"
            android:contentDescription="@string/layers_down"
            app:icon="@drawable/ic_arrow_down" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/duplicate"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1"
            android:contentDescription="@string/layers_duplicate"
            app:icon="@drawable/ic_copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rename"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1"
            android:text="@string/layers_rename" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/delete"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/layers_delete"
            app:icon="@drawable/ic_delete" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/group"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1"
            android:text="@string/layers_group" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ungroup"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1"
            android:text="@string/layers_ungroup" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/mergeVisible"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/layers_merge_visible" />
    </LinearLayout>
</LinearLayout>
