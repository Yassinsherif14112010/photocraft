<?xml version="1.0" encoding="utf-8"?>
<!-- Compact editor top bar: back, title + save status, undo / redo, export, overflow. -->
<com.google.android.material.appbar.MaterialToolbar
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editorTopBar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/pc_topbar"
    app:contentInsetStartWithNavigation="0dp"
    app:menu="@menu/menu_editor"
    app:navigationIcon="@drawable/ic_close"
    app:navigationContentDescription="@string/common_close"
    app:titleCentered="false"
    tools:title="Sunset poster">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.PhotoCraft.ToolbarTitle"
            tools:text="Sunset poster" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/editor_saved"
            android:textAppearance="@style/TextAppearance.PhotoCraft.Caption" />
    </LinearLayout>
</com.google.android.material.appbar.MaterialToolbar>
