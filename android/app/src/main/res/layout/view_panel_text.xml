<?xml version="1.0" encoding="utf-8"?>
<!-- Text Studio: real type layers through the engine's `type.create` command, with the character
     controls the engine supports (font, size, colour, alignment, tracking, line height). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pc_surface_panel"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_3">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_title"
        android:textAppearance="@style/Widget.PhotoCraft.PanelTitle" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textBox"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:hint="@string/text_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/textInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start|top"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/fontSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/text_font" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/boldSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/text_bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/sizeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/text_size"
        android:textAppearance="@style/TextAppearance.PhotoCraft.Caption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/sizeSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1.0"
        android:value="48.0"
        android:valueFrom="6.0"
        android:valueTo="400.0" />

    <TextView
        android:id="@+id/trackingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_tracking"
        android:textAppearance="@style/TextAppearance.PhotoCraft.Caption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/trackingSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1.0"
        android:value="0.0"
        android:valueFrom="-200.0"
        android:valueTo="500.0" />

    <TextView
        android:id="@+id/leadingLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_line_height"
        android:textAppearance="@style/TextAppearance.PhotoCraft.Caption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/leadingSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="0.05"
        android:value="1.2"
        android:valueFrom="0.7"
        android:valueTo="3.0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/text_align"
        android:textAppearance="@style/TextAppearance.PhotoCraft.Caption" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/alignGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alignStart"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_align_start" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alignCenter"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_align_center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alignEnd"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/text_align_end" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/rtlSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/text_rtl" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/apply"
        style="@style/Widget.PhotoCraft.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/text_add" />
</LinearLayout>
