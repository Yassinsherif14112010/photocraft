<?xml version="1.0" encoding="utf-8"?>
<!-- Adjustments. Every control maps to a real engine command: non-destructive adjustment layers
     for hue/saturation and invert, and image-level auto corrections. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pc_surface_panel"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_2"
    android:paddingBottom="@dimen/space_3">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/adjust_title"
        android:textAppearance="@style/Widget.PhotoCraft.PanelTitle" />

    <TextView
        android:id="@+id/hueLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/adjust_hue"
        android:textAppearance="@style/TextAppearance.PhotoCraft.Caption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/hueSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1.0"
        android:value="0.0"
        android:valueFrom="-180.0"
        android:valueTo="180.0" />

    <TextView
        android:id="@+id/saturationLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/adjust_saturation"
        android:textAppearance="@style/TextAppearance.PhotoCraft.Caption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/saturationSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1.0"
        android:value="0.0"
        android:valueFrom="-100.0"
        android:valueTo="100.0" />

    <TextView
        android:id="@+id/lightnessLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/adjust_lightness"
        android:textAppearance="@style/TextAppearance.PhotoCraft.Caption" />

    <com.google.android.material.slider.Slider
        android:id="@+id/lightnessSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stepSize="1.0"
        android:value="0.0"
        android:valueFrom="-100.0"
        android:valueTo="100.0" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/applyHue"
        style="@style/Widget.PhotoCraft.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_2"
        android:text="@string/adjust_apply" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/invert"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1"
            android:layout_weight="1"
            android:text="@string/adjust_invert" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/blackWhite"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/adjust_black_white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_1"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/autoTone"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_1"
            android:layout_weight="1"
            android:text="@string/adjust_auto_tone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/autoContrast"
            style="@style/Widget.PhotoCraft.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/adjust_auto_contrast" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_3"
        android:text="@string/adjust_note"
        android:textAppearance="@style/TextAppearance.PhotoCraft.Caption" />
</LinearLayout>
