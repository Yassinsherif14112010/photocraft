<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.PhotoCraft.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_1"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/thumb"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:contentDescription="@string/a11y_asset"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_image" />

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/space_2"
            android:paddingTop="@dimen/space_2"
            android:paddingEnd="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.PhotoCraft.Title"
            tools:text="logo-dark" />

        <TextView
            android:id="@+id/meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="@dimen/space_2"
            android:paddingBottom="@dimen/space_2"
            android:textAppearance="@style/TextAppearance.PhotoCraft.Caption"
            tools:text="1024 × 1024 · 240 kB" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
